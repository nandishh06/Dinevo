# Dscape frontend — environment template.
# Copy to .env and fill in real values. NEVER commit a real .env.

# Supabase project URL (public; safe to expose to the browser).
VITE_SUPABASE_URL=

# Supabase anon/publishable key (public by design; used for browser Auth).
# This is NOT the service-role key.
VITE_SUPABASE_ANON_KEY=

# Dscape FastAPI backend base URL used by the dashboard + customer menu API
# layer. Defaults to http://localhost:8000 in development.
VITE_API_URL=http://localhost:8000
