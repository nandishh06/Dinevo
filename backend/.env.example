# Dscape Dine AR backend — environment template.
# Copy to backend/.env and fill in real values. NEVER commit a real .env.

# ---- Supabase (SaaS data, auth, storage) ---------------------------------
# Project URL (https://<ref>.supabase.co). Used to reach Postgres + Storage.
SUPABASE_URL=https://meywyupopdhqefwmfkfb.supabase.co

# Service-role key. SERVER ONLY — never expose to the browser. Bypasses RLS;
# the backend must scope every query by the authenticated owner.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1leXd5dXBvcGRocWVmd21ma2ZiIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4OTEzNDI2MiwiZXhwIjoyMTA0NzEwMjYyfQ.z3xxC78IyZqIKEy4TZLS-PlBsNEn8Y9OaMebzZUReQQ

# Legacy JWT secret (HS256). Only needed to verify OLD HS256 tokens. Current
# Supabase projects sign access tokens with ES256/RS256, which the backend
# verifies automatically via the project JWKS endpoint — no secret required.
# Keep this set for backward compatibility with legacy HS256 tokens.
SUPABASE_JWT_SECRET=

# ---- Meshy Image-to-3D API key (https://www.meshy.ai -> API Key).
# Required for REAL generation (worker). Automated tests never use it.
MESHY_API_KEY=

# ---- fal.ai API key (https://fal.ai/dashboard/keys). SERVER ONLY.
# Used by FalTrellisProvider when IMAGE_TO_3D_PROVIDER=fal.
FAL_KEY=

# SQLAlchemy database URL. SQLite for local development.

# Public base URL for generated assets served by LocalAssetStorage.
# IMPORTANT: real Meshy execution requires the SOURCE IMAGE URL to be
# externally reachable by Meshy's servers. http://localhost/... is NOT
# reachable from outside your machine — for a real run, set this to a
# publicly accessible base (e.g. a deployed instance or a tunnel), or the
# stored originals must live somewhere Meshy can fetch.

# Local storage directory for generated assets (gitignored).

# Meshy polling: how long to sleep between status polls, and the hard cap
# on total wait time before the generation is marked FAILED.

# Image->3D provider selection: "meshy" (paid/cloud) or "trellis" (free/local
# GPU via the Colab TRELLIS worker). The Mac backend stays GPU-free either way.
IMAGE_TO_3D_PROVIDER=meshy

# Local TRELLIS worker job directory (shared with the Colab worker). The
# backend writes request.json here; the worker writes status.json + model.glb.
# For the immediate Colab workflow this must be a directory both sides can see
# (e.g. mounted/synced volume); a network transport can replace it later.
TRELLIS_JOB_DIR=./data/trellis_jobs

# Staged transport subdirectories (development bridge):
#   staging/ = jobs the Mac backend wrote, waiting to sync out to Colab
#   results/ = completed jobs synced back from Colab (worker output)
# The $0 bridge (Google Drive folder shared via Colab mount + rclone/Drive
# Desktop on the Mac) moves job dirs between these and the shared folder.
TRELLIS_STAGING_DIR=./data/trellis_jobs/staging
TRELLIS_RESULTS_DIR=./data/trellis_jobs/results
