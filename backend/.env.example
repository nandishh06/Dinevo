# Dscape Dine AR backend — environment template.
# Copy to backend/.env and fill in real values. NEVER commit a real .env.

# ---- Supabase (SaaS data, auth, storage) ---------------------------------
# Project URL (https://<ref>.supabase.co). Used to reach Postgres + Storage.
SUPABASE_URL=

# Secret API key (sb_secret_...). SERVER ONLY — never expose to the browser.
# Bypasses RLS; the backend must scope every query by the authenticated owner.
SUPABASE_SECRET_KEY=

# Legacy JWT secret (HS256). Only needed to verify OLD HS256 tokens. Current
# Supabase projects sign access tokens with ES256/RS256, which the backend
# verifies automatically via the project JWKS endpoint — no secret required.
# Keep this set for backward compatibility with legacy HS256 tokens.
SUPABASE_JWT_SECRET=

# ---- fal.ai Image-to-3D (https://fal.ai/dashboard/keys). SERVER ONLY. -----
# Used by FalTrellisProvider when IMAGE_TO_3D_PROVIDER=fal.
FAL_KEY=

# Image->3D provider selection: "fal" (fal.ai TRELLIS, cloud) or "trellis"
# (free/local GPU via the Colab TRELLIS worker). Defaults to "fal".
IMAGE_TO_3D_PROVIDER=fal

# Local TRELLIS worker job directory (shared with the Colab worker). The
# backend writes request.json here; the worker writes status.json + model.glb.
# For the immediate Colab workflow this must be a directory both sides can see
# (e.g. mounted/synced volume); a network transport can replace it later.
TRELLIS_JOB_DIR=./data/trellis_jobs

# Staged transport subdirectories (development bridge):
#   staging/ = jobs the Mac backend wrote, waiting to sync out to Colab
#   results/ = completed jobs synced back from Colab (worker output)
# The $0 bridge (Google Drive folder shared via Colab mount + rclone/Drive
# Desktop on the Mac) moves job dirs between these and the shared folder.
TRELLIS_STAGING_DIR=./data/trellis_jobs/staging
TRELLIS_RESULTS_DIR=./data/trellis_jobs/results

# ---- TEST-ONLY ------------------------------------------------------------
# Supabase anon key used only by the RLS integration test
# (backend/tests/test_rls_integration.py). Not used by the app at runtime.
# Set to run that test; otherwise leave blank.
SUPABASE_ANON_KEY=
